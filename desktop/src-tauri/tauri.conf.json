{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Llama Harness",
  "version": "0.1.0",
  "identifier": "com.tyhuang.llama-harness",
  "build": {
    "beforeDevCommand": "npm --prefix .. run desktop:before-dev",
    "devUrl": "http://127.0.0.1:5174",
    "beforeBuildCommand": "npm --prefix ../admin-ui run build",
    "frontendDist": "../../admin-ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Llama Harness",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 620,
        "decorations": true,
        "resizable": true,
        "maximizable": true,
        "minimizable": true,
        "closable": true,
        "fullscreen": false,
        "maximized": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "../../bundled/litellm-runtime/**/*"
    ]
  }
}
