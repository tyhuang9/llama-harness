{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Llama Harness Developer Console",
  "version": "0.1.0",
  "identifier": "com.tyhuang.llama-harness.console",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5175",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{"title": "Llama Harness Developer Console", "width": 1360, "height": 900, "minWidth": 960, "minHeight": 640}],
    "security": {"csp": "default-src 'self'; connect-src ipc: http://ipc.localhost"}
  },
  "bundle": {"active": true, "targets": "all", "icon": ["icons/icon.ico"]}
}
